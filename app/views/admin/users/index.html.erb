<h1>Admin &middot; All Users</h1>
<p><strong>Total users:</strong> <%= @users.size %></p>

<table>
  <thead>
    <tr>
      <th>Email</th>
      <th>Joined</th>
      <th>Admin</th>
      <th>Cards</th>
      <th>Mastered</th>
      <th>Answers</th>
      <th>Correct</th>
      <th>Accuracy</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <% accuracy = user.attempts_count.to_i.zero? ? 0.0 : ((user.correct_count.to_f / user.attempts_count) * 100).round(1) %>
      <tr>
        <td><%= user.email %></td>
        <td><%= user.created_at.to_date.iso8601 %></td>
        <td><%= user.admin? ? "Yes" : "" %></td>
        <td><%= user.cards_count %></td>
        <td><%= user.mastered_count %></td>
        <td><%= user.attempts_count %></td>
        <td><%= user.correct_count %></td>
        <td><%= accuracy %>%</td>
        <td><%= link_to "View dashboard", admin_user_path(user) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
