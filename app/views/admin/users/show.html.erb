<p><%= link_to "&larr; Back to all users".html_safe, admin_users_path %></p>

<h1>Admin &middot; <%= @user.email %></h1>
<p><small>Joined <%= @user.created_at.to_date.iso8601 %><%= " · admin" if @user.admin? %></small></p>

<div class="stats-grid">
  <div class="card"><h3>Cards</h3><p><%= @cards_count %></p></div>
  <div class="card"><h3>Mastered</h3><p><%= @mastered_count %></p></div>
  <div class="card"><h3>Total Answers</h3><p><%= @attempts_count %></p></div>
  <div class="card"><h3>Correct</h3><p><%= @correct_count %></p></div>
  <div class="card"><h3>Incorrect</h3><p><%= @incorrect_count %></p></div>
  <div class="card"><h3>Accuracy</h3><p><%= @accuracy %>%</p></div>
</div>

<section class="card">
  <h2>Recent Quiz Results</h2>
  <% if @recent_quizzes.any? %>
    <table>
      <thead>
        <tr>
          <th>When</th>
          <th>Mode</th>
          <th>Score</th>
          <th>Accuracy</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_quizzes.each do |quiz| %>
          <% total = quiz.quiz_attempts.size %>
          <% correct = quiz.quiz_attempts.count(&:correct) %>
          <% accuracy = total.zero? ? 0.0 : ((correct.to_f / total) * 100).round(1) %>
          <tr>
            <td><%= time_ago_in_words(quiz.completed_at) %> ago</td>
            <td><%= quiz.en_to_es? ? "English → Spanish" : "Spanish → English" %></td>
            <td><%= correct %> / <%= total %></td>
            <td><%= accuracy %>%</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>This user has not completed any quizzes yet.</p>
  <% end %>
</section>

<section class="card">
  <h2>Cards (<%= @cards.size %>)</h2>
  <% if @cards.any? %>
    <table>
      <thead>
        <tr>
          <th>English</th>
          <th>Spanish</th>
          <th>Type</th>
          <th>Attempts</th>
          <th>Correct</th>
          <th>Mastery</th>
          <th>Streak</th>
          <th>Status</th>
          <th>Last seen</th>
        </tr>
      </thead>
      <tbody>
        <% @cards.each do |card| %>
          <% stat = card.user_card_stat %>
          <%
            row_class, status_label =
              if stat.blank? || stat.total_attempts.zero?
                ["", "New"]
              elsif stat.mastery_score > UserCardStat::MASTERY_THRESHOLD &&
                    stat.total_attempts >= UserCardStat::MASTERY_MIN_ATTEMPTS
                ["row-correct", "Mastered"]
              elsif stat.incorrect_attempts.positive? &&
                    stat.mastery_score < UserCardStat::MASTERY_THRESHOLD
                ["row-incorrect", "Needs practice"]
              else
                ["", "Learning"]
              end
          %>
          <tr class="<%= row_class %>">
            <td><%= card.english_text %></td>
            <td><%= card.spanish_text %></td>
            <td><%= card.part_of_speech %></td>
            <td><%= stat&.total_attempts || 0 %></td>
            <td><%= stat&.correct_attempts || 0 %></td>
            <td><%= stat ? "#{stat.mastery_score}%" : "—" %></td>
            <td><%= stat&.streak || 0 %></td>
            <td><%= status_label %></td>
            <td><%= stat&.last_seen_at ? "#{time_ago_in_words(stat.last_seen_at)} ago" : "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>This user hasn't added any cards yet.</p>
  <% end %>
</section>
