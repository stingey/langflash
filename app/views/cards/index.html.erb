<h1>Your Cards</h1>
<p><strong>Total cards:</strong> <span id="cards-total-count"><%= @cards.count %></span></p>
<div class="actions">
  <%= link_to "Add New Card", new_card_path, class: "button" %>

  <% if @noun_progress[:seed_owned] >= @noun_progress[:total_seed] %>
    <button type="button"
            class="button button-secondary"
            disabled
            title="You've added every common noun in our list">
      All <%= @noun_progress[:total_seed] %> common nouns added
    </button>
  <% else %>
    <%= button_to "Add #{@batch_size} common nouns (#{@noun_progress[:seed_owned]}/#{@noun_progress[:total_seed]} added)",
                  import_common_nouns_cards_path,
                  method: :post,
                  class: "button button-secondary" %>
  <% end %>

  <% if @verb_progress[:seed_owned] >= @verb_progress[:total_seed] %>
    <button type="button"
            class="button button-secondary"
            disabled
            title="You've added every common verb in our list">
      All <%= @verb_progress[:total_seed] %> common verbs added
    </button>
  <% else %>
    <%= button_to "Add #{@batch_size} common verbs (#{@verb_progress[:seed_owned]}/#{@verb_progress[:total_seed]} added)",
                  import_common_verbs_cards_path,
                  method: :post,
                  class: "button button-secondary" %>
  <% end %>
</div>

<nav class="filter-pills" aria-label="Card filters">
  <% [
    ["all", "All"],
    ["nouns", "Nouns"],
    ["verbs", "Verbs"],
    ["mastered", "Mastered"],
    ["needs_practice", "Needs Practice"],
    ["recent", "Recently Added"]
  ].each do |slug, label| %>
    <%= link_to label,
                cards_path(filter: slug),
                class: "filter-pill#{' filter-pill-active' if @filter == slug}" %>
  <% end %>
</nav>

<% if @cards.any? %>
  <div class="cards-list">
    <% @cards.each do |card| %>
      <article id="<%= dom_id(card) %>" class="card card-tile">
        <%= button_to card_path(card),
                      method: :delete,
                      class: "card-delete-button",
                      title: "Delete card",
                      aria: { label: "Delete #{card.english_text}" } do %>
          <span aria-hidden="true">&#x2715;</span>
        <% end %>
        <h3><%= link_to card.english_text, card_path(card) %></h3>
        <p><%= card.spanish_text %></p>
      </article>
    <% end %>
  </div>
<% else %>
  <p>
    <% case @filter
       when "nouns" %>No noun cards yet.
    <% when "verbs" %>No verb cards yet.
    <% when "mastered" %>You haven't mastered any cards yet. Keep practicing!
    <% when "needs_practice" %>Nice — no cards are giving you trouble right now.
    <% when "recent" %>No cards yet — add some to see them here.
    <% else %>No cards yet.
    <% end %>
  </p>
<% end %>
