<h1>Your Dashboard</h1>

<div class="stats-grid">
  <div class="card">
    <h3>Cards</h3>
    <p><%= @cards_count %></p>
  </div>
  <div class="card">
    <h3>Mastered</h3>
    <p><%= @mastered_count %></p>
  </div>
  <div class="card">
    <h3>Total Answers</h3>
    <p><%= @attempts_count %></p>
  </div>
  <div class="card">
    <h3>Correct</h3>
    <p><%= @correct_count %></p>
  </div>
  <div class="card">
    <h3>Incorrect</h3>
    <p><%= @incorrect_count %></p>
  </div>
  <div class="card">
    <h3>Accuracy</h3>
    <p><%= @accuracy %>%</p>
  </div>
</div>

<section class="card">
  <h2>Start a Quiz</h2>

  <div class="quiz-launcher">
    <h3>English &rarr; Spanish</h3>
    <div class="actions">
      <% QuizSession::ALLOWED_QUESTION_COUNTS.each do |count| %>
        <%= button_to "#{count} questions",
                      start_quiz_path(mode: :en_to_es, question_count: count),
                      method: :post,
                      class: "button" %>
      <% end %>
    </div>
  </div>

  <div class="quiz-launcher">
    <h3>Nouns only</h3>
    <div class="actions">
      <% QuizSession::ALLOWED_QUESTION_COUNTS.each do |count| %>
        <%= button_to "#{count} questions",
                      start_quiz_path(mode: :en_to_es, question_count: count, category: :noun),
                      method: :post,
                      class: "button button-secondary" %>
      <% end %>
    </div>
  </div>

  <div class="quiz-launcher">
    <h3>Verbs only</h3>
    <div class="actions">
      <% QuizSession::ALLOWED_QUESTION_COUNTS.each do |count| %>
        <%= button_to "#{count} questions",
                      start_quiz_path(mode: :en_to_es, question_count: count, category: :verb),
                      method: :post,
                      class: "button button-secondary" %>
      <% end %>
    </div>
  </div>

  <div class="quiz-launcher">
    <h3>Hard mode &mdash; rare words from your bank</h3>
    <p class="quiz-launcher-hint">
      Pulls only from the rarest tiers of words you've collected, weighted toward the rarest.
    </p>
    <div class="actions">
      <% QuizSession::ALLOWED_QUESTION_COUNTS.each do |count| %>
        <%= button_to "#{count} questions",
                      start_quiz_path(mode: :en_to_es, question_count: count, difficulty: :hard),
                      method: :post,
                      class: "button button-danger" %>
      <% end %>
    </div>
  </div>
</section>

<section class="card">
  <h2>Recent Quiz Results</h2>
  <% if @recent_quizzes.any? %>
    <table>
      <thead>
        <tr>
          <th>When</th>
          <th>Mode</th>
          <th>Score</th>
          <th>Accuracy</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_quizzes.each do |quiz| %>
          <% total = quiz.quiz_attempts.size %>
          <% correct = quiz.quiz_attempts.count(&:correct) %>
          <% accuracy = total.zero? ? 0.0 : ((correct.to_f / total) * 100).round(1) %>
          <tr>
            <td><%= time_ago_in_words(quiz.completed_at) %> ago</td>
            <td><%= quiz.en_to_es? ? "English → Spanish" : "Spanish → English" %></td>
            <td><%= correct %> / <%= total %></td>
            <td><%= accuracy %>%</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No quizzes taken yet. Start one above!</p>
  <% end %>
</section>

<section class="card">
  <h2>Recently Added Cards</h2>
  <% if @recent_cards.any? %>
    <ul>
      <% @recent_cards.each do |card| %>
        <li><%= link_to card.spanish_text, card_path(card) %></li>
      <% end %>
    </ul>
  <% else %>
    <p>No cards yet. <%= link_to "Create your first card", new_card_path %>.</p>
  <% end %>
</section>
