<% content_for(:title, "Reset password") %>

<div class="auth-shell">
  <div class="auth-card">
    <%= link_to "LangFlash", root_path, class: "auth-brand" %>
    <p class="auth-tagline">We'll email you a link to set a new password.</p>

    <h1>Forgot your password?</h1>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name),
                 html: { method: :post }) do |f| %>
      <div class="field">
        <%= f.label :email %>
        <%= f.email_field :email,
                          autofocus: true,
                          autocomplete: "email",
                          placeholder: "you@example.com" %>
      </div>

      <%= f.submit "Send reset instructions", class: "button auth-submit" %>
    <% end %>

    <div class="auth-divider">or</div>

    <div class="auth-links">
      <%= link_to "Back to login", new_session_path(resource_name) %>
      <% if devise_mapping.registerable? %>
        <span>New here? <%= link_to "Create an account", new_registration_path(resource_name) %></span>
      <% end %>
    </div>
  </div>
</div>
