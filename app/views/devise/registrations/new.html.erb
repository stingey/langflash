<% content_for(:title, "Sign up") %>

<div class="auth-shell">
  <div class="auth-card">
    <%= link_to "Langflash", root_path, class: "auth-brand" %>
    <p class="auth-tagline">Build your Spanish vocabulary, one card at a time.</p>

    <h1>Create your account</h1>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <div class="field">
        <%= f.label :email %>
        <%= f.email_field :email,
                          autofocus: true,
                          autocomplete: "email",
                          placeholder: "you@example.com" %>
      </div>

      <div class="field">
        <%= f.label :password %>
        <%= f.password_field :password,
                             autocomplete: "new-password",
                             placeholder: "At least #{@minimum_password_length} characters" %>
        <% if @minimum_password_length %>
          <small style="color:#6b7280;">Use <%= @minimum_password_length %>+ characters.</small>
        <% end %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "Confirm password" %>
        <%= f.password_field :password_confirmation,
                             autocomplete: "new-password",
                             placeholder: "Repeat your password" %>
      </div>

      <%= f.submit "Sign up", class: "button auth-submit" %>
    <% end %>

    <div class="auth-divider">or</div>

    <div class="auth-links">
      <span>Already have an account? <%= link_to "Log in", new_session_path(resource_name) %></span>
    </div>
  </div>
</div>
