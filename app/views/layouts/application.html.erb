<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "LangFlash" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if user_signed_in? %>
      <header class="site-header" data-controller="nav">
        <div class="site-header-inner">
          <%= link_to "LangFlash", authenticated_root_path, class: "brand" %>

          <button type="button"
                  class="nav-toggle"
                  aria-label="Open menu"
                  aria-expanded="false"
                  data-nav-target="toggle"
                  data-action="click->nav#toggle">
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
          </button>

          <nav class="nav-links" data-nav-target="menu">
            <%= link_to "Dashboard", dashboard_path, class: "nav-link", data: { action: "click->nav#close" } %>
            <%= link_to "Cards", cards_path, class: "nav-link", data: { action: "click->nav#close" } %>
            <%= link_to "Progress", progress_path, class: "nav-link", data: { action: "click->nav#close" } %>
            <%= link_to "Leaderboard", leaderboard_path, class: "nav-link", data: { action: "click->nav#close" } %>
            <% if current_user.admin? %>
              <%= link_to "Admin", admin_users_path, class: "nav-link", data: { action: "click->nav#close" } %>
            <% end %>
            <%= button_to "Quick Quiz", start_quiz_path(mode: :en_to_es), method: :post, class: "link-button nav-cta" %>
            <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "link-button button-secondary" %>
          </nav>
        </div>
      </header>
    <% end %>

    <main class="container">
      <% if notice.present? %>
        <p class="flash notice"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="flash alert"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
