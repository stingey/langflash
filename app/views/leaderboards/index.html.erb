<h1>Leaderboard</h1>
<p><small>
  Ranked by quiz accuracy.
  You qualify with at least <%= @min_attempts %> answers
  <%= @period == "all" ? "all-time" : "in the #{@period_label.downcase}" %>.
</small></p>

<nav class="leaderboard-periods" style="margin-bottom: 1rem;">
  <% @periods.each do |key, config| %>
    <% if key == @period %>
      <strong><%= config[:label] %></strong>
    <% else %>
      <%= link_to config[:label], leaderboard_path(period: key) %>
    <% end %>
    <%= " · " unless key == @periods.keys.last %>
  <% end %>
</nav>

<% if @entries.any? %>
  <table>
    <thead>
      <tr>
        <th>Rank</th>
        <th>User</th>
        <th>Accuracy</th>
        <th>Answers</th>
        <th>Last attempt</th>
      </tr>
    </thead>
    <tbody>
      <% @entries.each_with_index do |entry, idx| %>
        <% user = entry[:user] %>
        <% is_me = user.id == current_user.id %>
        <tr class="<%= "row-correct" if is_me %>">
          <td><%= idx + 1 %></td>
          <td>
            <%= user.email.to_s.split("@").first %><%= " (you)" if is_me %>
          </td>
          <td><%= entry[:accuracy] %>%</td>
          <td><%= entry[:correct] %> / <%= entry[:total] %></td>
          <td>
            <% if entry[:last_attempt_at].present? %>
              <%= time_ago_in_words(entry[:last_attempt_at]) %> ago
            <% else %>
              —
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <section class="card">
    <p>No one has qualified for the <%= @period_label.downcase %> leaderboard yet.
       Answer at least <%= @min_attempts %> quiz questions to be the first!</p>
    <p><%= link_to "Take a quiz", quiz_path, class: "button" %></p>
  </section>
<% end %>
