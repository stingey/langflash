<section class="quiz-screen" data-controller="quiz">
  <h1>
    Quiz Time
    <% unless @quiz_session.category_all? %>
      <span class="quiz-category-badge"><%= @quiz_session.category.pluralize.titleize %> only</span>
    <% end %>
    <% if @quiz_session.hard? %>
      <span class="quiz-difficulty-badge">Hard mode</span>
    <% end %>
  </h1>
  <p class="quiz-progress">Question <%= @question_number %> of <%= @quiz_session.question_count %></p>
  <p class="quiz-prompt"><span><%= @question[:prompt_text] %></span></p>

  <div class="choices-grid">
    <% @question[:choices].each do |choice| %>
      <%= button_to choice,
                    answer_quiz_path(selected_choice: choice),
                    method: :post,
                    class: "choice-button",
                    data: { action: "click->quiz#press" } %>
    <% end %>
  </div>
</section>
